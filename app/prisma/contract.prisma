// Flonion Desk — Prisma contract
//
// This schema maps to the same Postgres database the tenant app writes to.
// `prisma contract emit` generates a type-safe client that decodes timestamps
// as plain strings instead of Temporal.PlainDateTime, letting the desk do all
// window calculations in SQL rather than JS.
//
// IMPORTANT: Never run `prisma migrate` against this schema. DDL changes go
// through the tenant app's migrations only.

generator client {
  provider = "prisma-client"
  output   = "../generated/contract"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Read models — every table the desk needs to query.
// ---------------------------------------------------------------------------

model User {
  id                   String           @id
  name                 String
  email                String
  emailVerified        Boolean          @default(false)
  image                String?
  role                 String           @default("member")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  twoFactorEnabled     Boolean?         @default(false)
  onboardingCompleted  Boolean          @default(false)
  banned               Boolean?         @default(false)
  banReason            String?
  banExpires           DateTime?
  sessions             Session[]
  accounts             Account[]
  twofactors           TwoFactor[]
  business             Business?        @relation("BusinessOwner")
  businessId           String?
  team                 Business?        @relation("BusinessMember", fields: [businessId], references: [id], onDelete: SetNull)
  sharedReviews        SharedReview[]
  feedback             Feedback[]
  googleToken          GoogleToken?
  meetingRequests      MeetingRequest[]
  assignedTasks        Task[]
  sentInvitations      Invitation[]     @relation("InvitationSender")
  joinRequests         JoinRequest[]    @relation("JoinRequestRequester")
  reviewedJoinRequests JoinRequest[]    @relation("JoinRequestReviewer")

  @@unique([email])
  @@index([businessId])
  @@map("user")
}

model GoogleToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  tokenType    String   @default("Bearer")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("google_token")
}

model Business {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation("BusinessOwner", fields: [userId], references: [id], onDelete: Cascade)
  placeId         String?
  reviewLink      String?
  reviewLinks     Json?
  logo            String?
  name            String
  username        String?   @unique
  phone           String?
  address         String?
  sector          String?
  keywords        String?
  description     String?
  rating          Float?
  reviewCount     Int?
  ratingUpdatedAt DateTime?
  qrScanCount     Int       @default(0)

  workingDays      String @default("1,2,3,4,5")
  workingStartTime String @default("09:00")
  workingEndTime   String @default("18:00")
  bookingStartTime String @default("14:00")
  bookingEndTime   String @default("17:00")
  slotDuration     Int    @default(30)
  timezone         String @default("Asia/Kolkata")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilitySlots AvailabilitySlot[]
  meetingRequests   MeetingRequest[]
  teamMembers       User[]             @relation("BusinessMember")
  tasks             Task[]
  teamMeetings      TeamMeeting[]
  invitations       Invitation[]
  joinRequests      JoinRequest[]
  services          Service[]
  projects          Project[]
  contacts          BusinessContact[]
  favoritePartners  FavoritePartner[]
  sharedReviews     SharedReview[]

  @@index([sector])
  @@index([rating, createdAt])
  @@map("business")
}

model AvailabilitySlot {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date       DateTime
  startTime  String
  endTime    String
  isBooked   Boolean  @default(false)
  title      String?
  createdAt  DateTime @default(now())

  meetingRequest MeetingRequest?

  @@unique([businessId, date, startTime])
  @@index([businessId, date])
  @@map("availability_slot")
}

model MeetingRequest {
  id          String           @id @default(cuid())
  slotId      String           @unique
  slot        AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requesterId String?
  requester   User?            @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  guestName   String?
  guestEmail  String?
  guestPhone  String?
  status      String           @default("pending")
  message     String?
  meetUri     String?
  meetSpaceId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([businessId, status])
  @@index([requesterId])
  @@map("meeting_request")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model SharedReview {
  id           String           @id @default(cuid())
  text         String
  rating       Int
  reviewerName String?
  keywords     String?
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId   String?
  business     Business?        @relation(fields: [businessId], references: [id], onDelete: SetNull)
  status       String           @default("visible")
  hiddenById   String?
  hiddenAt     DateTime?
  analytics    ReviewAnalytics?
  createdAt    DateTime         @default(now())

  @@index([userId])
  @@index([businessId])
  @@index([status])
  @@map("shared_review")
}

model ReviewAnalytics {
  id                String       @id @default(cuid())
  reviewId          String       @unique
  review            SharedReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  visitCount        Int          @default(0)
  reviewCount       Int          @default(0)
  qrScanCount       Int          @default(0)
  redirectCount     Int          @default(0)
  aiCopyCount       Int          @default(0)
  platformRedirects Json?        @default("{}")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([reviewId])
  @@map("review_analytics")
}

model Feedback {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  email        String
  category     String
  rating       Int
  message      String
  status       String    @default("new")
  assignedTo   String?
  resolvedAt   DateTime?
  operatorNote String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([status, createdAt])
  @@map("feedback")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  column      String    @default("todo")
  priority    String    @default("medium")
  dueDate     DateTime?
  position    Int       @default(0)
  assigneeId  String
  assignee    User      @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId, column])
  @@index([assigneeId])
  @@map("task")
}

model TeamMeeting {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  startTime   String
  endTime     String
  location    String
  meetUri     String?
  meetSpaceId String?
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, date])
  @@map("team_meeting")
}

model Invitation {
  id          String   @id @default(cuid())
  email       String
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role        String   @default("member")
  invitedById String
  invitedBy   User     @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  token       String   @unique
  status      String   @default("pending")
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([businessId])
  @@map("invitation")
}

model JoinRequest {
  id                         String    @id @default(cuid())
  businessId                 String
  business                   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId                     String
  user                       User      @relation("JoinRequestRequester", fields: [userId], references: [id], onDelete: Cascade)
  pendingUserId              String?   @unique
  message                    String?
  status                     String    @default("pending")
  grantedRole                String?
  consentDeleteOwnedBusiness Boolean   @default(false)
  reviewedById               String?
  reviewedBy                 User?     @relation("JoinRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt                 DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([businessId, status])
  @@index([userId, createdAt])
  @@map("join_request")
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  icon        String
  title       String
  description String
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
  @@map("service")
}

model Project {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  imageUrl   String
  altText    String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
  @@map("project")
}

model BusinessContact {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  role       String
  avatarUrl  String?
  email      String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
  @@map("business_contact")
}

model FavoritePartner {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@map("favorite_partner")
}

model AiUsage {
  id               String   @id @default(cuid())
  userId           String?
  businessId       String?
  endpoint         String
  stage            String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costUsd          Decimal? @db.Decimal(12, 6)
  latencyMs        Int
  ok               Boolean  @default(true)
  errorKind        String?
  reviewId         String?
  ip               String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([businessId, createdAt])
  @@index([endpoint, createdAt])
  @@map("ai_usage")
}

model AuditLog {
  id         String   @id @default(cuid())
  operatorId String
  action     String
  entity     String
  entityId   String
  before     Json?
  after      Json?
  note       String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([operatorId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}
