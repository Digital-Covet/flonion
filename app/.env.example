# === Flonion Desk ===
# Copy this file to .env and fill in the values.

# ─── Database ───────────────────────────────────────────────
# Direct connection to the SAME database used by the tenant app.
# Must be a direct connection string (not pooled) so Prisma client
# can access the schema outside of the tenant's Prisma client.
DATABASE_URL="postgresql://user:password@localhost:5432/flonion"

# ─── Operator Authentication ────────────────────────────────
# Comma-separated list of operator_id:sha256(token) pairs. Only the digest
# lives here; operators keep the token itself. The operator_id (lowercase
# letters, digits, "_" and "-") is what the audit log records.
# Generate a token with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# and its digest with:
#   node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" <token>
# Example: "op_jane:3f9a...64 hex chars...,op_bob:81c2...64 hex chars..."
DESK_OPERATORS=""

# ─── Impersonation ──────────────────────────────────────────
# The URL of the tenant app (e.g., https://flonion.com).
TENANT_APP_URL="http://localhost:3000"

# HMAC secret for signing impersonation tokens.
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPERATOR_HANDOFF_SECRET=""

# ─── Development ────────────────────────────────────────────
# Set to "production" in deployments.
NODE_ENV="development"
