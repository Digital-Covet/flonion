{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!**/dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "solid": "recommended",
      "tailwind": "recommended",
      "types": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/app.tsx",
        "src/entry-client.tsx",
        "src/components/**",
        "src/features/**",
        "src/constants/**",
        "src/types/**",
        "src/routes/**/*.tsx",
        "src/lib/public-review.ts",
        "src/lib/impersonation.ts",
        "src/server/analytics.ts",
        "src/server/business.ts",
        "src/server/company.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "effect": "Effect is server-only here: reach it through `await import(...)` inside a \"use server\" body."
                },
                "patterns": [
                  {
                    "group": ["effect/*", "~/server/effect/**", "@/server/effect/**"],
                    "message": "Server-only: reach it through `await import(...)` inside a \"use server\" body."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
